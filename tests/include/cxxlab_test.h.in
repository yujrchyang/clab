#pragma once

#include <filesystem>
#include <string>

// Root directory for all test temporary files (under build/)
#define CXXLAB_TEST_DIR "@CMAKE_BINARY_DIR@/test_tmp"

// Return a unique file path template suitable for mkstemp.
// The returned string ends with "_<name>_XXXXXX".
inline std::string cxxlab_tmp_path(const char *name) {
    auto dir = std::filesystem::path(CXXLAB_TEST_DIR);
    std::filesystem::create_directories(dir);
    return (dir / ("cxxlab_" + std::string(name))).string() + "_XXXXXX";
}

// Return a unique directory path template suitable for mkdtemp.
// The returned string ends with "_<name>_XXXXXX".
inline std::string cxxlab_tmp_dir(const char *name) {
    auto dir = std::filesystem::path(CXXLAB_TEST_DIR);
    std::filesystem::create_directories(dir);
    return (dir / ("cxxlab_" + std::string(name))).string() + "_XXXXXX";
}
